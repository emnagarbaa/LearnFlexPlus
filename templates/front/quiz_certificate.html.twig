{% extends 'front/home.html.twig' %}

{% block title %}Certificat - LearnFlex+{% endblock %}

{% block body %}
<main class="main-content" style="padding: 60px 20px; display: flex; justify-content: center; align-items: center; min-height: 80vh;">
    <div class="card certificate-card" style="max-width: 700px; width: 100%; padding: 40px; text-align: center; box-shadow: 0 10px 20px rgba(0,0,0,0.15); border-radius: 15px;">
        <h1 style="font-size: 36px; margin-bottom: 20px;">🎓 Certificat de réussite</h1>
        <p style="font-size: 20px;">Ce certificat est décerné à :</p>
        <h2 style="margin: 20px 0;">{{ app.user.prenom }} {{ app.user.nom }}</h2>

       
        <p style="margin-top: 30px;">Félicitations pour vos efforts et votre réussite !</p>

        <a href="{{ path('quiz_download_certificate', {'quizId': quizId}) }}" class="btn btn-primary" style="margin-top: 20px; padding: 12px 20px; font-size: 16px;">
            📥 Télécharger le certificat (PDF)
        </a>
    </div>
</main>
{% endblock %}

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Certificat</title>

<style>

@page {
    size: A4 landscape;
    margin: 0;
}

body{
    margin:0;
    padding:0;
    font-family: DejaVu Sans, sans-serif;
}

/* Taille réelle A4 */
.page{
    width:297mm;
    height:210mm;
    position:relative;
}

/* Bordure principale */
.outer-border{
    position:absolute;
    top:10mm;
    left:10mm;
    right:10mm;
    bottom:10mm;
    border:8px solid #2c3e50;
}

/* Bordure dorée */
.inner-border{
    position:absolute;
    top:18mm;
    left:18mm;
    right:18mm;
    bottom:18mm;
    border:2px solid #c9a227;
}

/* Contenu */
.content{
    position:absolute;
    top:40mm;
    left:25mm;
    right:25mm;
    text-align:center;
}

/* Logo */
.logo img{
    height:50px;
    margin-bottom:8mm;
}

/* Titre */
.title{
    font-size:30px;
    letter-spacing:2px;
    color:#2c3e50;
    margin-bottom:6mm;
}

/* Sous titre */
.subtitle{
    font-size:16px;
    color:#666;
    margin-bottom:10mm;
}

/* Texte */
.text{
    font-size:16px;
    margin:4mm 0;
}

/* Nom étudiant */
.name{
    font-size:28px;
    font-weight:bold;
    color:#c9a227;
    text-transform:uppercase;
    margin:8mm 0;
}

/* Quiz */
.quiz{
    font-size:20px;
    font-weight:bold;
    color:#2c3e50;
    margin:6mm 0;
}

/* Score */
.score{
    font-size:18px;
    margin-top:6mm;
    font-weight:bold;
}

/* Signature + date */
.footer{
    position:absolute;
    bottom:35mm;
    left:30mm;
    right:30mm;
    display:flex;
    justify-content:space-between;
    font-size:14px;
}

/* ID certificat */
.cert-id{
    position:absolute;
    bottom:15mm;
    width:100%;
    text-align:center;
    font-size:11px;
    color:#888;
}

</style>
</head>

<body>

<div class="page">

    <div class="outer-border"></div>
    <div class="inner-border"></div>

    <div class="content">

        <div class="logo">
<img src="{{ absolute_url(asset('assets/images/logo1.png')) }}">
        </div>

        <div class="title">CERTIFICAT DE RÉUSSITE</div>
        <div class="subtitle">Plateforme E-Learning LearnFlexPlus</div>

        <div class="text">Ce certificat est décerné à</div>

        <div class="name">
            {{ app.user.prenom }} {{ app.user.nom }}
        </div>

        <div class="text">Pour avoir validé avec succès le quiz</div>

        
    </div>

    <div class="footer">
        <div>
            _______________________<br>
            Responsable pédagogique
        </div>

        <div>
            Date : {{ "now"|date("d/m/Y") }}
        </div>
    </div>

    <div class="cert-id">
Certificat N° {{ certId }}    </div>
<div style="position:absolute; bottom:30mm; right:25mm;">
    <img src="data:image/png;base64,{{ qrCode }}" width="130">
</div>
</div>

</body>
</html>
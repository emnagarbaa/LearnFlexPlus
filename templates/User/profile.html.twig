{% extends 'front/home.html.twig' %}

{% block title %}Mon Profil - LearnFlexPlus{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
<link rel="stylesheet" href="{{ asset('assets/css/auth.css') }}">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
/* ===== Navbar ===== */
.profile-nav {
  background:#fff;
  box-shadow:0 4px 20px rgba(0,0,0,.06);
  position:sticky;
  top:0;
  z-index:1000;
  padding:12px 0;
}
.profile-nav .container{
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.profile-nav-left{
  display:flex;
  align-items:center;
  gap:12px;
}
.profile-nav-left img{height:42px}
.profile-nav-title .brand{
  font-weight:800;
  color:#1f4f65;
}
.profile-nav-title .page{
  font-size:14px;
  color:#666;
}

/* ===== Layout ===== */
.profile-wrapper{
  padding:50px 0;
  background:linear-gradient(135deg,#f8f9fa 0%,#e9f5ee 100%);
  min-height:calc(100vh - 80px);
}

.profile-card{
  background:#fff;
  border-radius:14px;
  box-shadow:0 10px 30px rgba(0,0,0,.08);
  padding:28px;
  max-width:920px;
  margin:auto;
}

.profile-grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
}
@media(max-width:768px){
  .profile-grid-2{grid-template-columns:1fr}
}

/* Avatar */
.profile-avatar{
  width:90px;
  height:90px;
  border-radius:50%;
  object-fit:cover;
  border:3px solid #e9ecef;
}
.avatar-placeholder{
  width:90px;
  height:90px;
  border-radius:50%;
  background:#f1f1f1;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:34px;
  color:#999;
}

.divider{
  margin:18px 0;
  border:none;
  height:1px;
  background:rgba(0,0,0,.08);
}
</style>
{% endblock %}

{# ================= HEADER ================= #}
{% block header %}
<header class="profile-nav">
  <div class="container">
    <div class="profile-nav-left">
      <a href="{{ path('app_front') }}" style="display:flex;align-items:center;gap:12px;">
        <img src="{{ asset('assets/images/logo1.png') }}">
        <div class="profile-nav-title">
          <div class="brand">LearnFlexPlus</div>
          <div class="page">Mon Profil</div>
        </div>
      </a>
    </div>

    <div style="display:flex;align-items:center;gap:12px;">
      <strong>{{ app.user.nom }} {{ app.user.prenom }}</strong>
      <form action="{{ path('app_logout') }}" method="post">
        <button class="btn btn-primary">
          <i class="fas fa-sign-out-alt"></i> Déconnexion
        </button>
      </form>
    </div>
  </div>
</header>
{% endblock %}

{# ================= BODY ================= #}
{% block body %}
<section class="profile-wrapper">
<div class="container">

{% for msg in app.flashes('success') %}
<div class="alert alert-success">{{ msg }}</div>
{% endfor %}
{% for msg in app.flashes('error') %}
<div class="alert alert-danger">{{ msg }}</div>
{% endfor %}

<div class="profile-card">

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
  <div>
    <h1>Informations du compte</h1>
    <p>Modifiez vos informations personnelles</p>
  </div>
  <a href="{{ path('app_front') }}" class="btn btn-outline">
    <i class="fas fa-arrow-left"></i> Retour
  </a>
</div>

{{ form_start(form, {'attr': {'class':'auth-form'}}) }}

{# ================= PROFILE IMAGE ================= #}
<div style="display:flex;align-items:center;gap:20px;margin-bottom:25px;">

  {% if app.user.profileImage %}
    <img class="profile-avatar"
         src="{{ asset('uploads/users/' ~ app.user.profileImage) }}">
  {% else %}
    <div class="avatar-placeholder">
      <i class="fas fa-user"></i>
    </div>
  {% endif %}

  <div style="flex:1;">
    <label>Changer la photo</label>
    {{ form_widget(form.profileImageFile) }}
    {{ form_errors(form.profileImageFile) }}
  </div>

</div>

{# ================= READONLY INFO ================= #}
<div class="profile-grid-2">
  <div class="form-group">
    <label>Email</label>
    <input type="text" value="{{ app.user.email }}" disabled>
  </div>

  <div class="form-group">
    <label>Date de création</label>
    <input type="text"
           value="{{ app.user.createdAt ? app.user.createdAt|date('d/m/Y H:i') : '—' }}"
           disabled>
  </div>
</div>

<hr class="divider">

{# ================= USER INFO ================= #}
<div class="profile-grid-2">
  <div class="form-group">
    <label>Prénom</label>
    {{ form_widget(form.prenom) }}
    {{ form_errors(form.prenom) }}
  </div>

  <div class="form-group">
    <label>Nom</label>
    {{ form_widget(form.nom) }}
    {{ form_errors(form.nom) }}
  </div>

  <div class="form-group">
    <label>Âge</label>
    {{ form_widget(form.age) }}
    {{ form_errors(form.age) }}
  </div>

  <div class="form-group">
    <label>Téléphone</label>
    {{ form_widget(form.telephone) }}
    {{ form_errors(form.telephone) }}
  </div>
</div>

<div class="form-group">
  <label>Adresse de résidence</label>
  {{ form_widget(form.adresseResidence) }}
  {{ form_errors(form.adresseResidence) }}
</div>

<hr class="divider">

<h3>Changer le mot de passe (optionnel)</h3>

<div class="profile-grid-2">
  <div class="form-group">
    <label>Nouveau mot de passe</label>
    {{ form_widget(form.newPassword) }}
    {{ form_errors(form.newPassword) }}
  </div>

  <div class="form-group">
    <label>Confirmer le mot de passe</label>
    {{ form_widget(form.confirmPassword) }}
    {{ form_errors(form.confirmPassword) }}
  </div>
</div>

<div style="margin-top:20px;">
  <button class="btn btn-primary btn-block">
    <i class="fas fa-save"></i> Enregistrer
  </button>
</div>

{{ form_end(form) }}

</div>{# /.profile-card #}

{# ================= FACE REGISTRATION CARD ================= #}
<div class="profile-card" style="margin-top:30px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <div>
            <h2>Register Face</h2>
            <p>Enregistrez votre visage pour la connexion Face ID</p>
        </div>
    </div>

    <div class="text-center">

        <!-- Video container with guides and overlays -->
        <div class="mb-3" style="display:flex;justify-content:center;">
            <div id="video-placeholder" class="border rounded d-flex align-items-center justify-content-center bg-light" style="width:400px;height:300px;">
                <div class="text-center p-4">
                    <i class="fas fa-camera fa-3x text-secondary mb-3"></i>
                    <p class="mb-0">Click "Start Camera" to begin</p>
                </div>
            </div>

            <!-- Camera wrapper: everything sits inside this relatively-positioned box -->
            <div id="camera-container" class="d-none" style="position:relative;width:400px;height:300px;overflow:hidden;border-radius:8px;">

                <!-- The video fills the container exactly -->
                <video id="video" playsinline
                       style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;display:block;"></video>

                <!-- Dark vignette + oval cutout using box-shadow trick -->
                <div style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:2;">
                    <!-- Oval guide ring -->
                    <div style="
                        position:absolute;
                        top:50%; left:50%;
                        transform:translate(-50%,-50%);
                        width:190px; height:220px;
                        border:3px solid rgba(255,255,255,0.85);
                        border-radius:50%;
                        box-shadow:0 0 0 9999px rgba(0,0,0,0.35);
                    "></div>
                </div>

                <!-- Face detection status badge -->
                <div id="face-status" style="
                    position:absolute;
                    bottom:12px; left:50%; transform:translateX(-50%);
                    padding:5px 14px;
                    border-radius:20px;
                    background-color:rgba(0,0,0,0.55);
                    color:white;
                    font-size:13px;
                    white-space:nowrap;
                    z-index:5;">
                    <i class="fas fa-user-slash me-1"></i> No face detected
                </div>

                <!-- Countdown overlay -->
                <div id="countdown-overlay" class="d-none" style="
                    position:absolute;top:0;left:0;
                    width:100%;height:100%;
                    background-color:rgba(0,0,0,0.4);
                    display:flex;align-items:center;justify-content:center;
                    z-index:10;">
                    <div id="countdown-text" style="color:white;font-size:5rem;font-weight:bold;line-height:1;">3</div>
                </div>
            </div>

            <canvas id="canvas" width="400" height="300" style="display:none;"></canvas>
        </div>

        <!-- Preview image -->
        <div class="mb-3 position-relative">
            <div id="preview-container" class="position-relative d-none">
                <img id="preview" alt="Captured Image" class="img-thumbnail mt-2" style="max-width:400px;max-height:300px;">
                <div id="image-quality" class="position-absolute top-0 end-0 m-2 badge bg-success d-none">Good quality</div>
            </div>
        </div>

        <!-- Control buttons -->
        <div class="d-flex justify-content-center gap-2 mt-3">
            <button class="btn btn-primary" id="start-camera">
                <i class="fas fa-video me-1"></i> Start Camera
            </button>
            <button class="btn btn-info d-none" id="capture">
                <i class="fas fa-camera me-1"></i> Capture
            </button>
            <button class="btn btn-success d-none" id="save">
                <i class="fas fa-save me-1"></i> Save Face
            </button>
            <button class="btn btn-secondary d-none" id="retry">
                <i class="fas fa-redo me-1"></i> Retry
            </button>
        </div>

        <!-- Status messages -->
        <div id="status" class="mt-3"></div>
    </div>
</div>

</div>{# /.container #}
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const video            = document.getElementById('video');
    const canvas           = document.getElementById('canvas');
    const captureButton    = document.getElementById('capture');
    const saveButton       = document.getElementById('save');
    const startButton      = document.getElementById('start-camera');
    const retryButton      = document.getElementById('retry');
    const preview          = document.getElementById('preview');
    const previewContainer = document.getElementById('preview-container');
    const statusDiv        = document.getElementById('status');
    const videoPlaceholder = document.getElementById('video-placeholder');
    const cameraContainer  = document.getElementById('camera-container');
    const faceStatusDiv    = document.getElementById('face-status');
    const countdownOverlay = document.getElementById('countdown-overlay');
    const countdownText    = document.getElementById('countdown-text');
    const imageQuality     = document.getElementById('image-quality');
    const email            = "{{ app.user.email|e('js') }}";

    let stream = null;
    let faceDetectionInterval = null;
    let faceDetected = false;

    // ── 1. Start camera ──────────────────────────────────────────────
    startButton.addEventListener('click', async function () {
        try {
            statusDiv.innerHTML = '<div class="alert alert-info">Initializing camera...</div>';
            startButton.disabled = true;

            stream = await navigator.mediaDevices.getUserMedia({
                video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: "user" }
            });

            video.srcObject = stream;
            await video.play();

            cameraContainer.classList.remove('d-none');
            videoPlaceholder.classList.add('d-none');
            startButton.classList.add('d-none');
            captureButton.classList.remove('d-none');

            statusDiv.innerHTML = '<div class="alert alert-info">Position your face within the circle guide and click "Capture" when ready.</div>';

            if (typeof faceapi !== 'undefined') {
                initFaceDetection();
            } else {
                faceStatusDiv.innerHTML = '<i class="fas fa-info-circle me-1"></i> Face detection not available';
            }
        } catch (err) {
            console.error('Webcam access error:', err);
            statusDiv.innerHTML = '<div class="alert alert-danger">Error accessing webcam. Please ensure your camera is connected and permissions are granted.</div>';
            startButton.disabled = false;
        }
    });

    // ── 2. Face detection (optional, requires face-api.js) ───────────
    async function initFaceDetection() {
        try {
            await Promise.all([
                faceapi.nets.tinyFaceDetector.loadFromUri('/face-api/models'),
                faceapi.nets.faceLandmark68Net.loadFromUri('/face-api/models')
            ]);

            faceDetectionInterval = setInterval(async () => {
                if (video.paused || video.ended) return;

                const detections = await faceapi
                    .detectAllFaces(video, new faceapi.TinyFaceDetectorOptions())
                    .withFaceLandmarks();

                if (detections.length > 0) {
                    const box         = detections[0].detection.box;
                    const videoCenter = { x: video.width / 2,       y: video.height / 2 };
                    const faceCenter  = { x: box.x + box.width / 2, y: box.y + box.height / 2 };
                    const distance    = Math.sqrt(Math.pow(faceCenter.x - videoCenter.x, 2) + Math.pow(faceCenter.y - videoCenter.y, 2));
                    const minSize     = video.height * 0.4;
                    const maxSize     = video.height * 0.6;

                    if (distance < 50 && box.height >= minSize && box.height <= maxSize) {
                        faceStatusDiv.innerHTML = '<i class="fas fa-check-circle me-1 text-success"></i> Good position';
                        faceStatusDiv.style.backgroundColor = 'rgba(40, 167, 69, 0.7)';
                        faceDetected = true;
                        captureButton.disabled = false;
                    } else {
                        const hint = box.height < minSize ? 'Move closer' : box.height > maxSize ? 'Move further away' : 'Center your face';
                        faceStatusDiv.innerHTML = `<i class="fas fa-arrows-alt me-1"></i> ${hint}`;
                        faceStatusDiv.style.backgroundColor = 'rgba(255, 193, 7, 0.7)';
                        faceDetected = false;
                        captureButton.disabled = true;
                    }
                } else {
                    faceStatusDiv.innerHTML = '<i class="fas fa-user-slash me-1"></i> No face detected';
                    faceStatusDiv.style.backgroundColor = 'rgba(220, 53, 69, 0.7)';
                    faceDetected = false;
                    captureButton.disabled = true;
                }
            }, 100);
        } catch (err) {
            console.error('Face detection initialization error:', err);
            captureButton.disabled = false;
        }
    }

    // ── 3. Capture with countdown ─────────────────────────────────────
    captureButton.addEventListener('click', function () {
        countdownOverlay.style.display = 'flex';
        captureButton.disabled = true;

        let count = 3;
        countdownText.textContent = count;

        const countdownInterval = setInterval(() => {
            count--;
            if (count > 0) {
                countdownText.textContent = count;
            } else {
                clearInterval(countdownInterval);
                countdownOverlay.style.display = 'none';
                takePicture();
            }
        }, 1000);
    });

    // ── 4. Take picture ───────────────────────────────────────────────
    function takePicture() {
        canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
        preview.src = canvas.toDataURL('image/png');
        previewContainer.classList.remove('d-none');

        imageQuality.classList.remove('d-none');
        if (faceDetected) {
            imageQuality.textContent = 'Good quality';
            imageQuality.classList.replace('bg-warning', 'bg-success');
        } else {
            imageQuality.textContent = 'Face not ideal';
            imageQuality.classList.replace('bg-success', 'bg-warning');
        }

        saveButton.classList.remove('d-none');
        retryButton.classList.remove('d-none');
        captureButton.classList.add('d-none');
        video.pause();

        if (faceDetectionInterval) clearInterval(faceDetectionInterval);

        statusDiv.innerHTML = '<div class="alert alert-info">Image captured. Click "Save Face" to register or "Retry" to capture again.</div>';
    }

    // ── 5. Retry ──────────────────────────────────────────────────────
    retryButton.addEventListener('click', function () {
        previewContainer.classList.add('d-none');
        if (video.paused && stream) video.play();

        saveButton.classList.add('d-none');
        retryButton.classList.add('d-none');
        captureButton.classList.remove('d-none');
        captureButton.disabled = !faceDetected;

        if (typeof faceapi !== 'undefined') initFaceDetection();
        statusDiv.innerHTML = '';
    });

    // ── 6. Save face (POST to /upload-face) ───────────────────────────
    saveButton.addEventListener('click', async function () {
        const imageData = canvas.toDataURL('image/png');
        saveButton.disabled = true;
        retryButton.disabled = true;

        statusDiv.innerHTML = `
            <div class="alert alert-info">
                <div class="d-flex align-items-center">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    <span>Processing and saving face data...</span>
                </div>
            </div>`;

        try {
            const response = await fetch('{{ path("app_upload_face") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ email, image: imageData })
            });

            const text = await response.text();

            if (response.ok) {
                statusDiv.innerHTML = `<div class="alert alert-success"><i class="fas fa-check-circle me-2"></i> ${text}</div>`;

                if (stream) stream.getTracks().forEach(t => t.stop());
                if (faceDetectionInterval) clearInterval(faceDetectionInterval);

                saveButton.classList.add('d-none');
                retryButton.classList.add('d-none');
                startButton.classList.remove('d-none');
                startButton.disabled = false;
                cameraContainer.classList.add('d-none');
                videoPlaceholder.classList.remove('d-none');
            } else {
                statusDiv.innerHTML = `<div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i> ${text}</div>`;
                saveButton.disabled = false;
                retryButton.disabled = false;
            }
        } catch (error) {
            console.error('Upload error:', error);
            statusDiv.innerHTML = `<div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i> Failed to upload face. Please try again.</div>`;
            saveButton.disabled = false;
            retryButton.disabled = false;
        }
    });

    // ── 7. Cleanup on page unload ─────────────────────────────────────
    window.addEventListener('beforeunload', () => {
        if (stream) stream.getTracks().forEach(t => t.stop());
        if (faceDetectionInterval) clearInterval(faceDetectionInterval);
    });
});
</script>
{% endblock %}

{% extends 'front/home.html.twig' %}

{% block title %}Mon Profil - LearnFlexPlus{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
<link rel="stylesheet" href="{{ asset('assets/css/auth.css') }}">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
/* ===== Navbar ===== */
.profile-nav {
  background:#fff;
  box-shadow:0 4px 20px rgba(0,0,0,.06);
  position:sticky;
  top:0;
  z-index:1000;
  padding:12px 0;
}
.profile-nav .container{
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.profile-nav-left{
  display:flex;
  align-items:center;
  gap:12px;
}
.profile-nav-left img{height:42px}
.profile-nav-title .brand{
  font-weight:800;
  color:#1f4f65;
}
.profile-nav-title .page{
  font-size:14px;
  color:#666;
}

/* ===== Layout ===== */
.profile-wrapper{
  padding:50px 0;
  background:linear-gradient(135deg,#f8f9fa 0%,#e9f5ee 100%);
  min-height:calc(100vh - 80px);
}

.profile-card{
  background:#fff;
  border-radius:14px;
  box-shadow:0 10px 30px rgba(0,0,0,.08);
  padding:28px;
  max-width:920px;
  margin:auto;
}

.profile-grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
}
@media(max-width:768px){
  .profile-grid-2{grid-template-columns:1fr}
}

/* Avatar */
.profile-avatar{
  width:90px;
  height:90px;
  border-radius:50%;
  object-fit:cover;
  border:3px solid #e9ecef;
}
.avatar-placeholder{
  width:90px;
  height:90px;
  border-radius:50%;
  background:#f1f1f1;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:34px;
  color:#999;
}

.divider{
  margin:18px 0;
  border:none;
  height:1px;
  background:rgba(0,0,0,.08);
}
</style>
{% endblock %}

{# ================= HEADER ================= #}
{% block header %}
<header class="profile-nav">
  <div class="container">
    <div class="profile-nav-left">
      <a href="{{ path('app_front') }}" style="display:flex;align-items:center;gap:12px;">
        <img src="{{ asset('assets/images/logo1.png') }}">
        <div class="profile-nav-title">
          <div class="brand">LearnFlexPlus</div>
          <div class="page">Mon Profil</div>
        </div>
      </a>
    </div>

    <div style="display:flex;align-items:center;gap:12px;">
      <strong>{{ app.user.nom }} {{ app.user.prenom }}</strong>
      <form action="{{ path('app_logout') }}" method="post">
        <button class="btn btn-primary">
          <i class="fas fa-sign-out-alt"></i> Déconnexion
        </button>
      </form>
    </div>
  </div>
</header>
{% endblock %}

{# ================= BODY ================= #}
{% block body %}
<section class="profile-wrapper">
<div class="container">

{% for msg in app.flashes('success') %}
<div class="alert alert-success">{{ msg }}</div>
{% endfor %}
{% for msg in app.flashes('error') %}
<div class="alert alert-danger">{{ msg }}</div>
{% endfor %}

<div class="profile-card">

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
  <div>
    <h1>Informations du compte</h1>
    <p>Modifiez vos informations personnelles</p>
  </div>
  <a href="{{ path('app_front') }}" class="btn btn-outline">
    <i class="fas fa-arrow-left"></i> Retour
  </a>
</div>

{{ form_start(form, {'attr': {'class':'auth-form'}}) }}

{# ================= PROFILE IMAGE ================= #}
<div style="display:flex;align-items:center;gap:20px;margin-bottom:25px;">

  {% if app.user.profileImage %}
    <img class="profile-avatar"
         src="{{ asset('uploads/users/' ~ app.user.profileImage) }}">
  {% else %}
    <div class="avatar-placeholder">
      <i class="fas fa-user"></i>
    </div>
  {% endif %}

  <div style="flex:1;">
    <label>Changer la photo</label>
    {{ form_widget(form.profileImageFile) }}
    {{ form_errors(form.profileImageFile) }}
  </div>

</div>

{# ================= READONLY INFO ================= #}
<div class="profile-grid-2">
  <div class="form-group">
    <label>Email</label>
    <input type="text" value="{{ app.user.email }}" disabled>
  </div>

  <div class="form-group">
    <label>Date de création</label>
    <input type="text"
           value="{{ app.user.createdAt ? app.user.createdAt|date('d/m/Y H:i') : '—' }}"
           disabled>
  </div>
</div>

<hr class="divider">

{# ================= USER INFO ================= #}
<div class="profile-grid-2">
  <div class="form-group">
    <label>Prénom</label>
    {{ form_widget(form.prenom) }}
    {{ form_errors(form.prenom) }}
  </div>

  <div class="form-group">
    <label>Nom</label>
    {{ form_widget(form.nom) }}
    {{ form_errors(form.nom) }}
  </div>

  <div class="form-group">
    <label>Âge</label>
    {{ form_widget(form.age) }}
    {{ form_errors(form.age) }}
  </div>

  <div class="form-group">
    <label>Téléphone</label>
    {{ form_widget(form.telephone) }}
    {{ form_errors(form.telephone) }}
  </div>
</div>

<div class="form-group">
  <label>Adresse de résidence</label>
  {{ form_widget(form.adresseResidence) }}
  {{ form_errors(form.adresseResidence) }}
</div>

<hr class="divider">

<h3>Changer le mot de passe (optionnel)</h3>

<div class="profile-grid-2">
  <div class="form-group">
    <label>Nouveau mot de passe</label>
    {{ form_widget(form.newPassword) }}
    {{ form_errors(form.newPassword) }}
  </div>

  <div class="form-group">
    <label>Confirmer le mot de passe</label>
    {{ form_widget(form.confirmPassword) }}
    {{ form_errors(form.confirmPassword) }}
  </div>
</div>

<div style="margin-top:20px;">
  <button class="btn btn-primary btn-block">
    <i class="fas fa-save"></i> Enregistrer
  </button>
</div>

{{ form_end(form) }}

</div>
</div>
</section>
{% endblock %}
